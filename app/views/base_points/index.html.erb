<div class="container mt-4">
  <h2 class="mb-4">拠点情報</h2>

  <%= link_to "拠点情報追加", new_base_point_path, class: "btn btn-primary mb-3" %>

  <table class="table table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th></th>
        <th>拠点番号</th>
        <th>拠点名</th>
        <th>勤怠種類</th>
      </tr>
    </thead>
    <tbody>
      <% @base_points.each do |base_point| %>
        <tr>
          <td>
            <%= link_to "修正", edit_base_point_path(base_point), class: "btn btn-primary btn-sm" %>
            <%= link_to "削除", base_point_path(base_point),
                        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
                        class: "btn btn-danger btn-sm" %>
          </td>
          <td><%= base_point.base_number %></td>
          <td><%= base_point.name %></td>
          <td><%= base_point.base_type %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
