<%# ヘッダー：ユーザー個人情報 %>
<div class="mt-3">
  <table class="table table-bordered text-center">
    <tr>
      <td class="align-middle">
        <%= link_to "←", user_path(@user, date: @first_day.prev_month),
                    class: "btn btn-sm btn-app" %>
        <%= l(@first_day, format: :middle) %> 時間管理表
        <%= link_to "→", user_path(@user, date: @first_day.next_month),
                    class: "btn btn-sm btn-app" %>
      </td>
      <td>
        指定勤務開始時間　<%= format_basic_info(@user.designated_work_start_time) %><br>
        指定勤務終了時間　<%= format_basic_info(@user.designated_work_end_time) %>
      </td>
      <td colspan="3" class="align-bottom">基本時間 <%= format_basic_info(@user.basic_time) %></td>
      <td colspan="1" class="align-bottom">初日　<%= @first_day.strftime('%m/%d') %></td>
    </tr>
    <tr>
      <td>所属　<%= @user.affiliation.presence || "未所属" %></td>
      <td>氏名　<%= @user.name %></td>
      <td>コード</td>
      <td><%= @user.employee_number %></td>
      <td>出勤日数　<%= @worked_sum %>日</td>
      <td>締め　<%= @last_day.strftime('%m/%d') %></td>
    </tr>
  </table>
</div>

<%# 通知ボタン3種（上長ユーザーのみ表示・勤怠を編集の上） %>
<% if current_user.superior? %>
  <div class="mb-2">
    <button type="button" class="btn btn-sm btn-outline-secondary d-block">
      【所属長承認申請のお知らせ】
      <% if @monthly_approval_count > 0 %>
        <span class="text-danger"><%= @monthly_approval_count %>件の通知があります</span>
      <% end %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary d-block">
      【勤怠変更申請のお知らせ】
      <% if @attendance_change_count > 0 %>
        <span class="text-danger"><%= @attendance_change_count %>件の通知があります</span>
      <% end %>
    </button>
    <button type="button" class="btn btn-sm btn-outline-secondary d-block">
      【残業申請のお知らせ】
      <% if @overtime_count > 0 %>
        <span class="text-danger"><%= @overtime_count %>件の通知があります</span>
      <% end %>
    </button>
  </div>
<% end %>

<%# 勤怠操作ボタン %>
<div class="mb-3">
  <%= link_to "勤怠を編集", edit_user_path(@user, date: @first_day), class: "btn btn-outline-secondary btn-sm" %>
</div>

<%# 勤怠テーブル %>
<div>
  <table class="table table-bordered table-hover text-center">
    <thead>
      <tr>
        <th rowspan="3">残業申請</th>
        <th rowspan="3">日付</th>
        <th rowspan="3">曜日</th>
        <th colspan="6">【実績】</th>
        <th colspan="5">所定外勤務</th>
      </tr>
      <tr>
        <th colspan="2">出社</th>
        <th colspan="2">退社</th>
        <th rowspan="2">在社時間</th>
        <th rowspan="2">備考</th>
        <th colspan="2">終了予定時間</th>
        <th rowspan="2">時間外時間</th>
        <th rowspan="2">業務処理内容</th>
        <th rowspan="2">指示者確認㊞</th>
      </tr>
      <tr>
        <th>時</th><th>分</th>
        <th>時</th><th>分</th>
        <th>時</th><th>分</th>
      </tr>
    </thead>

    <tbody>
      <% @attendances.each do |day| %>
        <% floored_started  = floor_to_15min(day.started_at) %>
        <% floored_finished = floor_to_15min(day.finished_at) %>
        <tr>
          <%# 残業申請列（Phase4で実装） %>
          <td></td>

          <td><%= l(day.worked_on, format: :short) %></td>
          <td class="<%= day_color_class(day.worked_on) %>">
            <%= %w[日 月 火 水 木 金 土][day.worked_on.wday] %>
          </td>

          <%# 出社列（時・分） %>
          <% if day.worked_on == Date.current && day.started_at.nil? %>
            <td colspan="2">
              <%= button_to "出社", user_attendance_path(@user, day),
                            method: :patch, class: "btn btn-primary btn-sm" %>
            </td>
          <% else %>
            <td><%= floored_started&.hour %></td>
            <td><%= floored_started&.strftime('%M') %></td>
          <% end %>

          <%# 退社列（時・分） %>
          <% if day.started_at.present? && day.finished_at.nil? %>
            <td colspan="2">
              <%= button_to "退社", user_attendance_path(@user, day),
                            method: :patch, class: "btn btn-warning btn-sm" %>
            </td>
          <% else %>
            <% finished_hour = floored_finished.present? && floored_finished.to_date > day.worked_on ?
                               floored_finished.hour + 24 : floored_finished&.hour %>
            <td><%= finished_hour %></td>
            <td><%= floored_finished&.strftime('%M') %></td>
          <% end %>

          <%# 在社時間 %>
          <td>
            <% if floored_started.present? && floored_finished.present? %>
              <%= working_times(floored_started, floored_finished) %>
            <% end %>
          </td>

          <%# 備考 %>
          <td><%= day.note %></td>

          <%# 終了予定時間・時間外時間・業務処理内容・指示者確認㊞（Phase4で実装） %>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
          <td></td>
        </tr>
      <% end %>
    </tbody>

    <tfoot>
      <tr>
        <td colspan="3">累計日数</td>
        <td colspan="5">総合勤務時間</td>
        <td colspan="6">累計在社時間</td>
      </tr>
      <tr>
        <td colspan="3"><%= @attendances.count %></td>
        <td colspan="5">
          <% if @user.basic_time.present? %>
            <%= format_basic_info(@user.basic_time).to_f * @worked_sum %>
          <% end %>
        </td>
        <td colspan="6">
          <% total = @attendances
                      .select { |d| d.started_at.present? && d.finished_at.present? }
                      .sum { |d|
                        working_times(floor_to_15min(d.started_at), floor_to_15min(d.finished_at)).to_f
                      } %>
          <%= format("%.2f", total) %>
        </td>
      </tr>
    </tfoot>
  </table>
</div>
