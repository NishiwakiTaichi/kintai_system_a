<%# 勤怠修正ログ（承認済）ページ %>
<div class="container mt-4">
  <h2 class="text-center mb-4">勤怠ログ</h2>

  <%# 年月フィルター（リンクで絞り込み）  %>
  <div class="mb-4">
    <%# リセットボタン %>
    <div class="mb-1">
      <%= link_to "リセット", attendance_log_user_path(@user), class: "btn btn-outline-secondary btn-sm text-dark" %>
    </div>

    <%# 年のドロップダウン（選択すると現在の月を維持したままGETリクエスト） %>
    <div class="mb-1 d-flex align-items-center gap-1">
      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm text-dark dropdown-toggle" type="button"
                data-bs-toggle="dropdown">年</button>
        <ul class="dropdown-menu">
          <li>
            <%= link_to "（全て）", attendance_log_user_path(@user, month: params[:month]), class: "dropdown-item" %>
          </li>
          <% (Date.current.year - 3..Date.current.year).each do |y| %>
            <li>
              <%= link_to y, attendance_log_user_path(@user, year: y, month: params[:month]), class: "dropdown-item" %>
            </li>
          <% end %>
        </ul>
      </div>
      <%# 選択中の年を表示する枠 %>
      <span class="form-control form-control-sm text-dark filter-display-box">
        <%= params[:year] %>
      </span>
    </div>

    <%# 月のドロップダウン（選択すると現在の年を維持したままGETリクエスト） %>
    <div class="mb-1 d-flex align-items-center gap-1">
      <div class="dropdown">
        <button class="btn btn-outline-secondary btn-sm text-dark dropdown-toggle" type="button"
                data-bs-toggle="dropdown">月</button>
        <ul class="dropdown-menu">
          <li>
            <%= link_to "（全て）", attendance_log_user_path(@user, year: params[:year]), class: "dropdown-item" %>
          </li>
          <% (1..12).each do |m| %>
            <li>
              <%= link_to m, attendance_log_user_path(@user, year: params[:year], month: m), class: "dropdown-item" %>
            </li>
          <% end %>
        </ul>
      </div>
      <%# 選択中の月を表示する枠 %>
      <span class="form-control form-control-sm text-dark filter-display-box">
        <%= params[:month] %>
      </span>
    </div>
  </div>

  <%# 勤怠修正ログテーブル %>
  <table class="table table-bordered table-sm text-center">
    <thead class="table-light">
      <tr>
        <th>日付</th>
        <th>変更前出社時間</th>
        <th>変更前退社時間</th>
        <th>変更後出社</th>
        <th>変更後退社</th>
        <th>指示者</th>
        <th>承認日</th>
      </tr>
    </thead>
    <tbody>
      <%# i が偶数（0, 2, 4...）→ 1行目・3行目なので白、奇数（1, 3, 5...）→ 2行目・4行目なのでグレー %>
      <% @attendance_logs.each_with_index do |log, i| %>
        <tr class="<%= i.odd? ? 'table-light' : '' %>">
          <td><%= log[:worked_on].strftime("%Y-%m-%d") %></td>
          <td><%= log[:before_started_at]&.strftime("%H:%M") %></td>
          <td><%= log[:before_finished_at]&.strftime("%H:%M") %></td>
          <td><%= log[:after_started_at]&.strftime("%H:%M") %></td>
          <td><%= log[:after_finished_at]&.strftime("%H:%M") %></td>
          <td><%= log[:supervisor_name] %></td>
          <td><%= log[:approved_at].strftime("%Y-%m-%d") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
