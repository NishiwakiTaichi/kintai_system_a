<div class="container mt-4">
  <h2 class="text-center mb-4"><%= params[:name].present? ? "検索結果" : "ユーザー一覧" %></h2>

  <%# CSVインポートフォーム %>
  <%= form_with url: import_users_path, method: :post, multipart: true, local: true do |f| %>
    <div class="d-flex flex-column align-items-start gap-2 mb-3">
      <%= f.file_field :csv_file, accept: ".csv", required: true %>
      <%= f.submit "CSVをインポート", class: "btn btn-app" %>
    </div>
  <% end %>

  <div class="d-flex justify-content-end align-items-start mb-3">

    <div class="card p-3 search-card">
      <div class="fw-bold mb-2">ユーザー名検索</div>
      <%= form_with url: users_path, method: :get, local: true do |f| %>
        <div class="input-group">
          <%= f.text_field :name, value: params[:name],
                          placeholder: "キーワードを入力...", class: "form-control form-control-sm" %>
          <%= f.submit "検索", class: "btn btn-app btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <%= will_paginate @users, renderer: Bootstrap5LinkRenderer,
                   previous_label: "前へ", next_label: "次へ" %>

  <%# ユーザー一覧（アコーディオン） %>
  <div class="accordion mt-2" id="usersAccordion">
    <% @users.each do |user| %>
      <div class="accordion-item">

        <%# ユーザー名・編集・削除ボタン行 %>
        <div class="row align-items-center px-3 py-2">
          <div class="col">
            <%= link_to user.name, "#",
                        data: { bs_toggle: "collapse", bs_target: "#user-form-#{user.id}" },
                        class: "text-decoration-none" %>
          </div>
          <% if current_user.admin? %>
            <div class="col-auto d-flex gap-2">
              <button class="btn btn-app btn-sm" type="button"
                      data-bs-toggle="collapse"
                      data-bs-target="#user-form-<%= user.id %>"
                      aria-expanded="false"
                      aria-controls="user-form-<%= user.id %>">
                編集
              </button>
              <%= link_to "削除", user,
                          data: { turbo_method: :delete, turbo_confirm: "#{user.name}を削除しますか？" },
                          class: "text-danger text-decoration-none" %>
            </div>
          <% end %>
        </div>

        <%# アコーディオンで展開する編集フォーム %>
        <div id="user-form-<%= user.id %>" class="accordion-collapse collapse">
          <div class="accordion-body border-top">
            <%= form_with model: user, url: update_basic_info_user_path(user), method: :patch, local: true do |f| %>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :name, "名前", class: "form-label" %>
                  <%= f.text_field :name, class: "form-control" %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= f.label :email, "メールアドレス", class: "form-label" %>
                  <%= f.email_field :email, class: "form-control" %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :affiliation, "所属", class: "form-label" %>
                  <%= f.text_field :affiliation, class: "form-control" %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= f.label :employee_number, "社員番号", class: "form-label" %>
                  <%= f.text_field :employee_number, class: "form-control" %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :password, "パスワード", class: "form-label" %>
                  <%= f.password_field :password, class: "form-control", autocomplete: "new-password",
                                      placeholder: "変更しない場合は空欄" %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= f.label :password_confirmation, "パスワード確認", class: "form-label" %>
                  <%= f.password_field :password_confirmation, class: "form-control",
                                      placeholder: "変更しない場合は空欄" %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :uid, "カードID", class: "form-label" %>
                  <%= f.text_field :uid, class: "form-control" %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= f.label :basic_time, "基本勤務時間", class: "form-label" %>
                  <%= f.time_field :basic_time, class: "form-control time-field" %>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <%= f.label :designated_work_start_time, "指定勤務開始時間", class: "form-label" %>
                  <%= f.time_field :designated_work_start_time, class: "form-control time-field" %>
                </div>
                <div class="col-md-6 mb-3">
                  <%= f.label :designated_work_end_time, "指定勤務終了時間", class: "form-label" %>
                  <%= f.time_field :designated_work_end_time, class: "form-control time-field" %>
                </div>
              </div>

              <%= f.submit "編集する", class: "btn btn-app w-100" %>
            <% end %>
          </div>
        </div>

      </div>
    <% end %>
  </div>

  <%= will_paginate @users, renderer: Bootstrap5LinkRenderer,
                   previous_label: "前へ", next_label: "次へ" %>
</div>
